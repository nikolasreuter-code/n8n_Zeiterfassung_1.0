        "jsCode": "const m=$input.first().json.message; if(!m?.voice?.file_id) return []; return [{json:{file_id:m.voice.file_id,chat_id:m.chat.id,user_id:m.from.id,message_id:m.message_id,received_at:new Date(m.date*1000).toISOString()}}];"
      },
