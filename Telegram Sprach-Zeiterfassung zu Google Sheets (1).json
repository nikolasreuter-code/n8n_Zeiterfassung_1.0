      "id": "fdbd1bb4-896d-4aa2-99af-9117311940e0",
      "name": "Sprache transkribieren",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        592,
        128
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model:'gpt-4o-mini',temperature:0,response_format:{type:'json_object'},messages:[{role:'system',content:'Extrahiere Zeiterfassung aus deutschem Text. Antworte ausschließlich als JSON mit Feldern date (YYYY-MM-DD), start (HH:mm), end (HH:mm), break_minutes (number), complete (boolean), question (string). Nutze Europe/Berlin. Interpretiere heute/gestern relativ zum übergebenen Datum. Keine Zeiten erfinden. Wenn Angaben fehlen complete=false und passende question.'},{role:'user',content:'Empfangszeit: '+$('Nur Sprachnachrichten').first().json.received_at+'; Text: '+$json.text}]}) }}",
        "options": {}
      },
      "id": "b4fee61a-917c-4ae6-837b-f385c77a27d5",
      "name": "Zeiten per KI extrahieren",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const meta=$('Nur Sprachnachrichten').first().json;let p;try{p=JSON.parse($input.first().json.choices[0].message.content)}catch(e){return [{json:{...meta,complete:false,question:'Ich konnte die Zeiten nicht erkennen. Bitte erneut sprechen.'}}]}if(!p.complete||!p.date||!p.start||!p.end||!Number.isFinite(Number(p.break_minutes)))return [{json:{...meta,complete:false,question:p.question||'Bitte Datum, Beginn, Ende und Pause nennen.'}}];const t=s=>{if(!/^([01]\\d|2[0-3]):[0-5]\\d$/.test(s))throw Error('Uhrzeit ungültig');const [h,m]=s.split(':').map(Number);return h*60+m};let duration=t(p.end)-t(p.start);if(duration<0)duration+=1440;const pause=Number(p.break_minutes);if(pause<0||pause>duration||duration>1440) return [{json:{...meta,complete:false,question:'Die Zeitangaben sind widersprüchlich. Bitte korrigieren.'}}];return [{json:{...meta,complete:true,Datum:p.date,Beginn:p.start,Ende:p.end,'Pause (Min)':pause,'Arbeitszeit (Std)':Number(((duration-pause)/60).toFixed(2)),Telegram_User_ID:String(meta.user_id)}}];"
      },
      "id": "0a8cd7eb-e5fd-4fc1-99b7-e384968547e7",
      "name": "Validieren und berechnen",
